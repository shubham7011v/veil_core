# ==========================================
# Veil Core - Environment Configuration
# ==========================================
# Copy this file to .env to apply local overrides.
# These values override defaults but are overridden by Build-time Env Vars.

# --- Core Environment ---
ENV=development
APP_NAME=Bluff

# --- Server Configuration ---
# WebSocket Server URL for game logic
SERVER_URL=ws://192.168.1.X:8080/ws
# REST API Base URL
API_URL=http://192.168.1.X:8080/api

# --- Connectivity & Reconnection ---
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_BASE_DELAY_MS=2000

# --- Game Logic Settings ---
DEFAULT_THINKING_TIME_S=10
DEFAULT_PLAYER_COUNT=5
MAX_PLAYERS=8
MATCHMAKING_DELAY_SECONDS=1

# --- Performance & Rate Limiting ---
MAX_ACTIONS_PER_SECOND=10

# --- UI & Animation ---
ANIMATION_DURATION_MS=300
CARD_DEAL_DELAY_MS=100

# --- Voice Chat Configuration ---
VOICE_TIMEOUT_SECONDS=30
VOICE_SAMPLE_RATE=48000

# --- Developer Options ---
ENABLE_LOGGING=true
DEBUG=true
# Comma-separated list of User IDs to grant Admin privileges
ADMIN_UIDS=

# --- Feature Flags (Boolean) ---
# Set to 'true' to enable, 'false' to disable

ENABLE_VOICE_CHAT=false
ENABLE_DAILY_CHALLENGES=false
ENABLE_TOURNAMENTS=false
ENABLE_ADMIN_DASHBOARD=true
ENABLE_PRIVATE_ROOMS=false
ENABLE_FRIENDS_MATCH=false
ENABLE_FRIENDS_MATCH_OFFLINE=false
ENABLE_BOT_PLAYERS=true
ENABLE_INNER_CIRCLE=false
ENABLE_GLOBAL_RANKINGS=false
ENABLE_ELITE_DECKS=false
ENABLE_GAME_CHAT=false

# --- Legal & Support Links ---
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
DATA_USAGE_URL=https://example.com/data-usage
SUPPORT_EMAIL=support@example.com
GAME_RULES_URL=https://example.com/rules
